{
  "sources": {
    "obsidian-kit": {
      "ref": "0.67.1"
    },
    "code-kit": {
      "ref": "0.36.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/code-kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "timeout",
        "sha256",
        "filename-template",
        "settings",
        "i18n",
        "busy-guard",
        "slug",
        "local-stamp",
        "marker-zone",
        "validate-input",
        "folder-scope",
        "rel-path"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "frontmatter",
        "frontmatter-patch",
        "vault-path"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "secrets"
      ],
      "vendorJson": "src/vendor/code-kit"
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "window-timers"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "settings_walker",
        "folder-suggest",
        "confirm",
        "hub",
        "secrets",
        "help-setting"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "scripts/vendor",
      "source": "obsidian-kit",
      "from": "src/build",
      "modules": [
        "node-builtin-require.mjs"
      ]
    }
  ]
}
