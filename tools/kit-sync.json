{
  "sources": {
    "obsidian-kit": {
      "ref": "0.100.0"
    },
    "code-kit": {
      "ref": "0.79.1"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/code-kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "timeout",
        "sha256",
        "filename-template",
        "settings",
        "i18n",
        "busy-guard",
        "slug",
        "local-stamp",
        "marker-zone",
        "validate-input",
        "folder-scope",
        "fold-case",
        "rel-path",
        "loopback",
        "text-window",
        "user-regex"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "frontmatter",
        "frontmatter-patch",
        "vault-path",
        "pseudonymizer-source",
        "image-gen-provider",
        "ocr-provider",
        "describe-provider"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../code-kit/"
        ],
        [
          "../pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "secrets",
        "error-message",
        "placeholder"
      ],
      "vendorJson": "src/vendor/code-kit"
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "window-timers"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "settings_walker",
        "folder-suggest",
        "confirm",
        "hub",
        "secrets",
        "help-setting",
        "status-bar-item",
        "setting-body-host",
        "plugin-api",
        "capability-apis",
        "pseudonymizer-call"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "tests",
      "modules": [
        "pseudonymizer-source.types.test.ts"
      ],
      "rewrite": [
        [
          "../src/pure/",
          "../../../src/vendor/kit/"
        ]
      ]
    },
    {
      "dir": "scripts/vendor",
      "source": "obsidian-kit",
      "from": "src/build",
      "modules": [
        "node-builtin-require.mjs"
      ]
    }
  ]
}
